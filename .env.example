# Copy this file to .env.local and fill in your real values.
# Never commit .env.local — it's already in .gitignore.

# Supabase — Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Mapbox — Account → Tokens in your Mapbox dashboard
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token
